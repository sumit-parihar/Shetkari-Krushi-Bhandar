# Copy to backend/.env and fill in. Never commit the real .env.
# On Render, set these in the service's Environment tab instead (no quotes there).

# PostgreSQL connection string (e.g. from Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random string for signing JWTs:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Frontend origin(s) allowed by CORS, comma-separated, no trailing slash
FRONTEND_URL=http://localhost:3000

# Brevo transactional email (API key needs "Transactional email: All")
BREVO_API_KEY=xkeysib-
SENDER_EMAIL=you@example.com
SENDER_NAME="Shetkari Krushi Bhandar"

# Local development only. Leave unset in production.
ENV=dev
